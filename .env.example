# LLM service (OpenAI-compatible API)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
REQUEST_TIMEOUT_SECONDS=120
TASK_TIMEOUT_SECONDS=600
LLM_RETRIES=2

# External tools
TAVILY_API_KEY=
TAVILY_RETRIES=1
WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.weatherapi.com/v1
WEATHER_PROVIDER=weatherapi
FETCH_RETRIES=1

# Persistence and artifacts
# Legacy API and orchestration runtime. Keep SQLite until the full runtime adapter is connected.
DATABASE_URL=sqlite:///./orchestration.db

# Team-scoped platform repositories. Disabled by default during compatibility rollout.
PLATFORM_REPOSITORY_BACKEND=disabled
PLATFORM_DATABASE_URL=
# PostgreSQL examples:
# Local PostgreSQL installed on Windows:
# PLATFORM_REPOSITORY_BACKEND=postgres
# PLATFORM_DATABASE_URL=postgresql://agent_platform:agent_platform_dev_only@127.0.0.1:5432/agent_platform_dev
# Docker Compose maps the container database to host port 54329:
# PLATFORM_DATABASE_URL=postgresql://agent_platform:agent_platform_dev_only@127.0.0.1:54329/agent_platform_dev
ARTIFACT_ROOT=artifacts
ARTIFACT_MAX_FILES_PER_TASK=10
ARTIFACT_MAX_FILE_BYTES=1048576
ARTIFACT_MAX_ARCHIVE_INPUT_BYTES=5242880

# Agent and workflow limits
MAX_SWARM_ROUNDS=2
HARD_MAX_SWARM_ROUNDS=3
MAX_AGENTS=4
HARD_MAX_AGENTS=6
MAX_CONCURRENT_AGENTS=2
HARD_MAX_CONCURRENT_AGENTS=3
MAX_TOOL_CALLS=12
REACT_MAX_TOOL_CALLS=5

# Research and web-fetch limits
MAX_FETCH_CHARS=12000
SEARCH_RESULTS_LIMIT=5
RESEARCH_MAX_QUERIES=5
RESEARCH_AUTO_FETCH_PAGES=3
RESEARCH_SUPPLEMENTAL_SEARCHES=1
EVIDENCE_PER_SUBTASK=3
FETCH_TOP_RESULTS=2

# Platform Gateway and worker
INTERNAL_API_TOKEN=replace-with-a-long-random-value
MODEL_MASTER_KEY=
MODEL_GATEWAY_ENABLED=false
MODEL_GATEWAY_URL=http://127.0.0.1:8080
MODEL_GATEWAY_WORKSPACE_ID=
MODEL_GATEWAY_VARIANT_ID=
PLATFORM_TASK_API_ENABLED=false
GATEWAY_ADDRESS=:8080
PYTHON_RUNTIME_URL=http://127.0.0.1:8000
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# Team document inputs
INPUT_FILE_ROOT=input_files
INPUT_FILE_MAX_BYTES=20971520
DOCUMENT_CONTEXT_MAX_CHARS=50000

# Initial administrator for gateway/cmd/bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=EZcode Admin
BOOTSTRAP_WORKSPACE_NAME=EZcode Team
BOOTSTRAP_WORKSPACE_SLUG=demo-team
